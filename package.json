{
  "name": "prisma-launcher",
  "productName": "Prisma",
  "version": "0.2.0",
  "description": "Uma única biblioteca para tudo que você joga: Steam, Epic, GOG, Xbox PC e executáveis avulsos.",
  "main": "./out/main/index.js",
  "author": "Prisma",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
